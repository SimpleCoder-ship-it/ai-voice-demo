# --- Azure Speech Service (STT) ---
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_ENDPOINT_KEY=https://your-resource-name.cognitiveservices.azure.com/
AZURE_SPEECH_REGION=eastus2

# --- Azure OpenAI Service ---
AZURE_OPENAI_KEY=your_azure_openai_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource-name.services.ai.azure.com/api/projects/your_project/openai/v1/responses
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
